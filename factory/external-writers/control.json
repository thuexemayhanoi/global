{
  "version": 1,
  "mode": "dynamic-pool",
  "max_batch": 5,
  "writers": [
    "W1",
    "W2",
    "W3"
  ],
  "no_ai_api": true,
  "no_open_source_ai": true,
  "no_auto_write": true,
  "no_auto_publish": true,
  "owner_review_required": true,
  "explanation": "Outside AI sessions W1/W2/W3 share all eligible Matrix IDs via serialized main claims. One session can write all remaining topics; CI only validates, owner approves publication.",
  "allocation": "shared-id-queue-any-of-W1-W2-W3",
  "claim_authority": "github-actions-writer-pool-on-main",
  "legacy_assignments": "historical-only",
  "protected_drafts": "factory/external-writers/protected-drafts.json"
}
