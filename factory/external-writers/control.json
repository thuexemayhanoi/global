{
  "version": 1,
  "mode": "dynamic-pool",
  "max_batch": 10,
  "writers": [
    "W1",
    "W2",
    "W3"
  ],
  "no_ai_api": true,
  "no_open_source_ai": true,
  "no_auto_write": true,
  "no_auto_publish": true,
  "owner_review_required": true,
  "explanation": "External W1/W2/W3 push up to 10 drafts. Green Writer QA triggers trusted Autopilot which atomically records completed packets and refills active session up to 10. Public publication remains separate owner reviewed.",
  "allocation": "shared-id-queue-any-of-W1-W2-W3",
  "claim_authority": "automatic-workflow_run-after-green-Writer-QA-on-main",
  "legacy_assignments": "historical-only",
  "protected_drafts": "factory/external-writers/protected-drafts.json",
  "auto_claim_after_green_writer_push": true,
  "auto_submit_drafts_after_green_writer_push": true,
  "owner_click_per_batch_required": false,
  "auto_publish": false,
  "editorial_review_required": true,
  "supporting_drafts_before_hub_published": true,
  "supporting_publish_requires_published_parent": true,
  "writer_turbo_default": 10,
  "partial_draft_submission": true,
  "minimum_drafts_per_push": 1,
  "max_simultaneous_writers": 3,
  "immutable_submitted_packet_sha": true,
  "checkpoint_source": "factory/external-writers/claims.json (revision + source_commit + source_sha256)"
}
